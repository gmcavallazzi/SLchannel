*.py[cod]
*$py.class
*.so
.Python
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
.installed.cfg

# --- Environments and tooling ------------------------------------------------
venv/
env/
ENV/
.venv
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

