!report/*.pdf
!docs/figures/*.png
!docs/figures/*.pdf
!docs/theory/*.pdf

# --- LaTeX build artifacts ---------------------------------------------------
*.aux
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
report/*.log
report/*.out

